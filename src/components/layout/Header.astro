---
/**
 * Header — Phase 1.7 Navigation Revolution
 *
 * CHANGES from original:
 * - Removed: all text nav links (HOME/LAB/STACK/ABOUT/CONTACT)
 * - Removed: language switcher (moved to footer)
 * - Removed: hamburger menu (replaced by ConstellationNav overlay)
 * - Added: MenuPill (three neuron dots) — appears when #about enters the viewport, opens ConstellationNav
 * - Logo slot is now empty (VKVLogo.svelte handles its own positioning)
 *
 * ConstellationNav is rendered in index.astro (not here) to avoid
 * Svelte island import issues inside layout .astro files.
 */
import type { Lang } from '@i18n/utils';

interface Props {
  lang: Lang;
}

// lang is kept in Props for potential future use (localized aria-labels)
const { lang } = Astro.props;
---

{/* MenuPill — three neuron dots, fixed top-right */}
<button
  class="menu-pill"
  id="menu-pill-btn"
  aria-label={lang === 'ru' ? 'Открыть меню навигации' : 'Open navigation menu'}
  aria-expanded="false"
  inert
>
  <span class="menu-dot"></span>
  <span class="menu-dot"></span>
  <span class="menu-dot"></span>
</button>

<style>
  /* ── Menu Pill ─────────────────────────────────────────────── */
  .menu-pill {
    position: fixed;
    /* env(): with viewport-fit=cover the fixed pill measures from the true
       screen edge — in the installed PWA a flat 16px lands it in the
       status-bar / Dynamic-Island strip. 0px everywhere else. */
    top: calc(16px + env(safe-area-inset-top, 0px));
    right: calc(16px + env(safe-area-inset-right, 0px));
    display: flex;
    gap: 6px;
    align-items: center;
    padding: 10px 16px;
    background: hsla(220, 25%, 8%, 0.7);
    border: 1px solid hsla(185, 60%, 50%, 0.12);
    border-radius: 320px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    cursor: pointer;
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.4s ease,
      border-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
    min-height: 44px; /* touch target */
  }

  /* The standard property, restated where the CSS minifier cannot rewrite it
     away: in the built bundle it collapses `backdrop-filter` into the -webkit-
     alias alone, and Firefox (standard-only) then renders a flat fill. The
     minifier does not merge across an @supports boundary, so this copy ships.
     Must stay AFTER the base rule — equal specificity, last one wins.
     Same idiom as .glass-panel / .hero-plate in src/styles/global.css. */
  @supports (backdrop-filter: blur(1px)) {
    .menu-pill {
      backdrop-filter: blur(12px);
    }
  }

  .menu-pill.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .menu-pill:hover {
    border-color: hsla(185, 60%, 50%, 0.3);
    box-shadow: 0 0 20px hsla(185, 60%, 50%, 0.15);
  }

  .menu-dot {
    display: block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: hsla(185, 60%, 60%, 0.6);
    transition: all var(--duration-normal) var(--ease-out);
  }

  .menu-pill:hover .menu-dot {
    background: hsla(185, 60%, 60%, 1);
    box-shadow: 0 0 8px hsla(185, 60%, 60%, 0.5);
  }

  /* Pulsing dots when overlay is open */
  .menu-pill[aria-expanded='true'] .menu-dot {
    background: hsl(185, 80%, 60%);
    box-shadow: 0 0 12px hsla(185, 80%, 60%, 0.6);
    animation: dot-pulse 1.2s ease-in-out infinite;
  }

  .menu-pill[aria-expanded='true'] .menu-dot:nth-child(2) {
    animation-delay: 0.2s;
  }

  .menu-pill[aria-expanded='true'] .menu-dot:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes dot-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.4);
      opacity: 0.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-pill[aria-expanded='true'] .menu-dot {
      animation: none;
    }
    .menu-pill {
      transition:
        opacity 0.1s,
        border-color 0.1s;
    }
  }

  /* ConstellationNav wrapper */
  #constellation-nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
  }

  /* ── Mobile: larger touch target ───────────────────────────── */
  @media (max-width: 767px) {
    .menu-pill {
      padding: 12px 18px;
    }
    .menu-dot {
      width: 5px;
      height: 5px;
    }
  }

  /* Reduced motion: a static state, never a running loop. */
  @media (prefers-reduced-motion: reduce) {
    .menu-pill[aria-expanded='true'] .menu-dot {
      animation: none;
    }
  }
</style>

<script>
  /**
   * MenuPill visibility + ConstellationNav toggle.
   * Visible once #about enters the viewport, including after it exits above.
   */
  const runtime = window as Window & { __vkvMenuPillCleanup?: () => void };
  runtime.__vkvMenuPillCleanup?.();

  const lifecycle = new AbortController();
  let disposePill: (() => void) | undefined;

  function stopMenuPill(): void {
    disposePill?.();
    disposePill = undefined;
  }

  function initMenuPill(): void {
    stopMenuPill();
    const menuPill = document.getElementById('menu-pill-btn');
    const aboutEl = document.getElementById('about');
    if (!menuPill || !aboutEl) return;

    // Hidden navigation must also stay out of the keyboard focus order.
    menuPill.classList.remove('visible');
    menuPill.inert = true;
    const events = new AbortController();
    let observer: IntersectionObserver | undefined;
    let refreshFrame: number | null = null;
    let lastIntersecting = false;
    let shown = false;
    let disposed = false;

    function setVisibility(next: boolean): void {
      if (disposed || next === shown) return;
      shown = next;
      menuPill!.classList.toggle('visible', shown);
      menuPill!.inert = !shown;
    }

    function refreshVisibility(): void {
      if (disposed || !observer || refreshFrame !== null) return;
      refreshFrame = requestAnimationFrame((): void => {
        refreshFrame = null;
        if (disposed || !observer) return;
        // A jump can move #about from below to above without intersecting.
        // Re-observing requests fresh asynchronous geometry, never a layout read.
        observer.takeRecords();
        observer.unobserve(aboutEl!);
        observer.observe(aboutEl!);
      });
    }

    function onScroll(): void {
      if (!lastIntersecting) refreshVisibility();
    }

    if (typeof IntersectionObserver === 'function') {
      observer = new IntersectionObserver((entries): void => {
        if (disposed) return;
        for (const entry of entries) {
          if (entry.target !== aboutEl) continue;
          lastIntersecting = entry.isIntersecting;
          const viewportBottom = entry.rootBounds?.bottom ?? window.innerHeight;
          setVisibility(entry.boundingClientRect.top < viewportBottom);
        }
      }, {
        // Also report positive area after an exact zero-area boundary contact.
        threshold: [0, Number.EPSILON],
      });
      observer.observe(aboutEl);
      window.addEventListener('scroll', onScroll, { passive: true, signal: events.signal });
      window.addEventListener('resize', refreshVisibility, { signal: events.signal });
      window.addEventListener('pageshow', refreshVisibility, { signal: events.signal });
      window.addEventListener('hashchange', refreshVisibility, { signal: events.signal });
      window.addEventListener('popstate', refreshVisibility, { signal: events.signal });
    } else {
      // Keep navigation usable in browsers without the visibility observer.
      setVisibility(true);
    }

    menuPill.addEventListener('click', (): void => {
      const isExpanded = menuPill.getAttribute('aria-expanded') === 'true';
      const newState = !isExpanded;
      menuPill.setAttribute('aria-expanded', String(newState));
      window.dispatchEvent(
        new CustomEvent('vkv:constellation-toggle', { detail: { open: newState } })
      );
    }, { signal: events.signal });

    window.addEventListener('vkv:constellation-close', (): void => {
      menuPill.setAttribute('aria-expanded', 'false');
    }, { signal: events.signal });

    disposePill = (): void => {
      if (disposed) return;
      disposed = true;
      observer?.disconnect();
      if (refreshFrame !== null) cancelAnimationFrame(refreshFrame);
      events.abort();
    };
  }

  function cleanup(): void {
    stopMenuPill();
    lifecycle.abort();
    if (runtime.__vkvMenuPillCleanup === cleanup) delete runtime.__vkvMenuPillCleanup;
  }

  runtime.__vkvMenuPillCleanup = cleanup;
  document.addEventListener('astro:before-swap', stopMenuPill, { signal: lifecycle.signal });
  document.addEventListener('astro:page-load', initMenuPill, { signal: lifecycle.signal });
  initMenuPill();
</script>
