---
import { AUDIT_PROOFS } from '@/data/audit-proof';
import { t } from '@i18n/utils';
import type { Lang } from '@i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat(lang === 'ru' ? 'ru-RU' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Yerevan',
});
const initialProof = AUDIT_PROOFS[0];
if (!initialProof) throw new Error('Audit proof data must include at least one report.');
const initialPosition = t(lang, 'auditProof.modal.reportPosition')
  .replace('{current}', '1')
  .replace('{total}', String(AUDIT_PROOFS.length));
---

<section class="audit-proof" id="audit-proof" aria-labelledby="audit-proof-heading">
  <div class="container">
    <header class="audit-proof__intro">
      <p class="audit-proof__eyebrow text-mono">{t(lang, 'auditProof.eyebrow')}</p>
      <h2 class="text-h2" id="audit-proof-heading">{t(lang, 'auditProof.heading')}</h2>
      <p class="audit-proof__lead">{t(lang, 'auditProof.lead')}</p>
    </header>

    <ul class="audit-proof__grid">
      {
        AUDIT_PROOFS.map((proof) => {
          const capture = proof.captures[0];
          if (!capture) return null;
          return (
            <li class="audit-proof__item">
              <a
                class="audit-proof__card"
                href={`/${lang}/audit-proofs/${proof.id}${capture.mode ? `-${capture.mode}` : ''}/`}
                data-audit-trigger
                data-audit-proof={proof.id}
                data-audit-panel={`audit-proof-panel-${proof.id}-${capture.mode ?? 'overview'}`}
                aria-haspopup="dialog"
                aria-controls="audit-proof-dialog"
              >
                <span class="audit-proof__card-top text-mono">
                  {t(lang, `auditProof.categories.${proof.id}`)}
                </span>
                <span class="audit-proof__card-art" aria-hidden="true">
                  <span class="audit-proof__grade text-mono">{proof.grade}</span>
                </span>
                <span class="audit-proof__card-halo" aria-hidden="true" />
                <span class="audit-proof__card-glass" aria-hidden="true" />
                <span class="audit-proof__card-info">
                  <span class="audit-proof__hook">{t(lang, proof.hookKey)}</span>
                  <span class="audit-proof__source">{proof.source}</span>
                  <span class="audit-proof__verified">
                    <span class="audit-proof__verified-value text-mono">{proof.grade}</span>
                    <span class="audit-proof__grade-context">{t(lang, proof.gradeContextKey)}</span>
                  </span>
                  <span class="audit-proof__description">{t(lang, proof.descriptionKey)}</span>
                  <span class="audit-proof__scores">
                    {proof.scoreKeys?.map((key) => (
                      <span>{t(lang, key)}</span>
                    ))}
                  </span>
                  <span class="audit-proof__date">
                    {t(lang, 'auditProof.scanned')}:{' '}
                    <time datetime={proof.scannedAt}>
                      {dateFormatter.format(new Date(proof.scannedAt))}
                    </time>
                  </span>
                  <span class="audit-proof__reveal text-mono">
                    {t(lang, 'auditProof.openCapture')}
                    <span aria-hidden="true">↗</span>
                  </span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>

    <p class="audit-proof__scope">{t(lang, 'auditProof.scope')}</p>
  </div>

  <dialog
    class="audit-proof__dialog"
    id="audit-proof-dialog"
    aria-labelledby="audit-proof-dialog-heading"
    aria-describedby="audit-proof-dialog-note"
    data-lenis-prevent
  >
    <header class="audit-proof__dialog-header">
      <div class="audit-proof__dialog-heading">
        <p class="audit-proof__dialog-eyebrow text-mono" data-audit-category>
          {t(lang, `auditProof.categories.${initialProof.id}`)}
        </p>
        <h3 id="audit-proof-dialog-heading" data-audit-heading>{initialProof.source}</h3>
        <p class="audit-proof__dialog-date">
          {t(lang, 'auditProof.scanned')}:{' '}
          <time datetime={initialProof.scannedAt} data-audit-date>
            {dateFormatter.format(new Date(initialProof.scannedAt))}
          </time>
        </p>
      </div>
      <div
        class="audit-proof__report-navigation"
        role="group"
        aria-label={t(lang, 'auditProof.modal.reportNavigation')}
      >
        <button
          class="audit-proof__report-nav-button"
          type="button"
          data-audit-previous
          aria-label={t(lang, 'auditProof.modal.previousReport')}
          aria-controls="audit-proof-reports"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m14 6-6 6 6 6" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </button>
        <span
          class="audit-proof__report-position text-mono"
          data-audit-position
          data-audit-position-template={t(lang, 'auditProof.modal.reportPosition')}
          aria-label={initialPosition}>1 / {AUDIT_PROOFS.length}</span
        >
        <button
          class="audit-proof__report-nav-button"
          type="button"
          data-audit-next
          aria-label={t(lang, 'auditProof.modal.nextReport')}
          aria-controls="audit-proof-reports"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m10 6 6 6-6 6" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </button>
      </div>
      <button
        class="audit-proof__dialog-close"
        type="button"
        data-audit-close
        aria-label={t(lang, 'auditProof.modal.close')}
        autofocus
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </header>

    <div
      class="audit-proof__dialog-body"
      id="audit-proof-reports"
      data-audit-scroll
      data-lenis-prevent
    >
      {
        AUDIT_PROOFS.map((proof, proofIndex) => (
          <div
            class="audit-proof__report-panel"
            data-audit-report-panel
            data-audit-proof={proof.id}
            data-audit-source={proof.source}
            data-audit-category-label={t(lang, `auditProof.categories.${proof.id}`)}
            data-audit-scanned-at={proof.scannedAt}
            data-audit-date-label={dateFormatter.format(new Date(proof.scannedAt))}
            data-audit-report-label={`${t(lang, 'auditProof.openReport')} — ${proof.source}`}
            hidden={proofIndex !== 0}
          >
            {proof.captures.length > 1 && (
              <div
                class="audit-proof__device-switch"
                role="group"
                aria-label={t(lang, 'auditProof.modal.deviceChoice')}
              >
                {proof.captures.map((capture, index) => (
                  <button
                    class="audit-proof__device-button text-mono"
                    type="button"
                    data-audit-select={`audit-proof-panel-${proof.id}-${capture.mode ?? 'overview'}`}
                    aria-controls={`audit-proof-panel-${proof.id}-${capture.mode ?? 'overview'}`}
                    aria-pressed={index === 0}
                  >
                    {t(lang, `auditProof.modes.${capture.mode}`)}
                  </button>
                ))}
              </div>
            )}
            {proof.captures.map((capture, index) => {
              const panelId = `audit-proof-panel-${proof.id}-${capture.mode ?? 'overview'}`;
              const modeLabel = capture.mode ? t(lang, `auditProof.modes.${capture.mode}`) : '';
              const captureAlt = t(
                lang,
                capture.mode ? 'auditProof.captureAltMode' : 'auditProof.captureAlt'
              )
                .replace('{source}', proof.source)
                .replace('{mode}', modeLabel);
              const reportUrl = new URL(proof.reportUrl);
              if (proof.id === 'pagespeed' && capture.mode) {
                reportUrl.searchParams.set('form_factor', capture.mode);
              }

              return (
                <div
                  class="audit-proof__dialog-panel"
                  id={panelId}
                  data-audit-panel
                  data-audit-report-url={reportUrl.href}
                  hidden={index !== 0}
                >
                  {proof.id === 'pagespeed' && capture.scores && capture.scores.length > 0 && (
                    <div class="audit-proof__score-summary">
                      <p
                        class="audit-proof__dialog-caption text-mono"
                        id={`${panelId}-scores-heading`}
                      >
                        <span>{t(lang, 'auditProof.modal.overview')}</span>
                        <span class="audit-proof__dialog-mode">{modeLabel}</span>
                      </p>
                      <dl
                        class="audit-proof__score-grid"
                        aria-labelledby={`${panelId}-scores-heading`}
                      >
                        {capture.scores.map((score) => (
                          <div class="audit-proof__score-metric">
                            <dt>{t(lang, score.labelKey)}</dt>
                            <dd class="audit-proof__score-value text-mono">{score.value}</dd>
                          </div>
                        ))}
                      </dl>
                    </div>
                  )}
                  <figure class="audit-proof__dialog-snapshot">
                    <figcaption class="audit-proof__dialog-caption text-mono">
                      <span>{t(lang, 'auditProof.modal.label')}</span>
                      {modeLabel && !capture.scores?.length && (
                        <span class="audit-proof__dialog-mode">{modeLabel}</span>
                      )}
                    </figcaption>
                    {proof.id === 'pagespeed' ? (
                      <div class="audit-proof__dialog-image-frame">
                        <img
                          class="audit-proof__dialog-image audit-proof__capture-image--light"
                          data-src={capture.src}
                          width={capture.width}
                          height={capture.height}
                          decoding="async"
                          alt={captureAlt}
                        />
                      </div>
                    ) : (
                      <img
                        class:list={{
                          'audit-proof__dialog-image': true,
                          'audit-proof__capture-image--light': proof.id !== 'browser',
                        }}
                        data-src={capture.src}
                        width={capture.width}
                        height={capture.height}
                        decoding="async"
                        alt={captureAlt}
                      />
                    )}
                  </figure>
                </div>
              );
            })}
          </div>
        ))
      }
    </div>

    <footer class="audit-proof__dialog-footer">
      <p class="audit-proof__dialog-note" id="audit-proof-dialog-note">
        {t(lang, 'auditProof.modal.sourceNote')}
        <span data-audit-colour-note> {t(lang, 'auditProof.darkPreview')}.</span>
      </p>
      <a
        class="audit-proof__dialog-report text-mono"
        href={initialProof.reportUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-audit-report
        aria-label={`${t(lang, 'auditProof.openReport')} — ${initialProof.source}`}
      >
        {t(lang, 'auditProof.modal.fullReport')}
        <span aria-hidden="true">↗</span>
      </a>
    </footer>
    <p
      class="visually-hidden"
      data-audit-announcement
      data-audit-announcement-template={t(lang, 'auditProof.modal.reportAnnouncement')}
      aria-live="polite"
      aria-atomic="true"
    >
    </p>
  </dialog>
</section>

<script>
  interface AuditLenis {
    readonly isStopped: boolean;
    stop(): void;
    start(): void;
  }

  interface AuditReportPanel {
    element: HTMLElement;
    id: string;
    source: string;
    category: string;
    scannedAt: string;
    dateLabel: string;
    reportLabel: string;
    captures: Map<string, HTMLElement>;
    selectedCaptureId: string;
  }

  interface AuditSwipe {
    pointerId: number;
    x: number;
    y: number;
  }

  const section = document.getElementById('audit-proof');
  const dialog = section?.querySelector<HTMLDialogElement>('#audit-proof-dialog');

  if (
    section &&
    typeof HTMLDialogElement !== 'undefined' &&
    dialog &&
    typeof dialog.showModal === 'function'
  ) {
    const motionAllowed = window.matchMedia('(prefers-reduced-motion: no-preference)');
    const reports: AuditReportPanel[] = Array.from(
      dialog.querySelectorAll<HTMLElement>('[data-audit-report-panel]')
    ).flatMap((element): AuditReportPanel[] => {
      const captures = new Map(
        Array.from(element.querySelectorAll<HTMLElement>('[data-audit-panel]')).map((panel) => [
          panel.id,
          panel,
        ])
      );
      const firstCaptureId = captures.keys().next().value;
      const {
        auditProof,
        auditSource,
        auditCategoryLabel,
        auditScannedAt,
        auditDateLabel,
        auditReportLabel,
      } = element.dataset;
      if (
        !firstCaptureId ||
        !auditProof ||
        !auditSource ||
        !auditCategoryLabel ||
        !auditScannedAt ||
        !auditDateLabel ||
        !auditReportLabel
      )
        return [];

      return [
        {
          element,
          id: auditProof,
          source: auditSource,
          category: auditCategoryLabel,
          scannedAt: auditScannedAt,
          dateLabel: auditDateLabel,
          reportLabel: auditReportLabel,
          captures,
          selectedCaptureId: firstCaptureId,
        },
      ];
    });
    const heading = dialog.querySelector<HTMLElement>('[data-audit-heading]');
    const category = dialog.querySelector<HTMLElement>('[data-audit-category]');
    const date = dialog.querySelector<HTMLTimeElement>('[data-audit-date]');
    const position = dialog.querySelector<HTMLElement>('[data-audit-position]');
    const announcement = dialog.querySelector<HTMLElement>('[data-audit-announcement]');
    const colourNote = dialog.querySelector<HTMLElement>('[data-audit-colour-note]');
    const previousButton = dialog.querySelector<HTMLButtonElement>('[data-audit-previous]');
    const nextButton = dialog.querySelector<HTMLButtonElement>('[data-audit-next]');
    const closeButton = dialog.querySelector<HTMLButtonElement>('[data-audit-close]');
    const reportLink = dialog.querySelector<HTMLAnchorElement>('[data-audit-report]');
    const scrollArea = dialog.querySelector<HTMLElement>('[data-audit-scroll]');
    const editableSelector =
      'input, textarea, select, [contenteditable]:not([contenteditable="false"])';
    const interactiveSelector = `a, button, summary, ${editableSelector}, [role="button"]`;
    let activeIndex = 0;
    let returnFocus: HTMLAnchorElement | null = null;
    let preservedLock = false;
    let pausedLenis: AuditLenis | null = null;
    let pageIsLocked = false;
    let closeRevision = 0;
    let backdropPointerDown = false;
    let swipe: AuditSwipe | null = null;

    const getLenis = (): AuditLenis | undefined =>
      (window as Window & { lenisInstance?: AuditLenis }).lenisInstance;

    const lockPage = (): void => {
      if (pageIsLocked) return;
      preservedLock = document.documentElement.classList.contains('audit-proof-modal-open');
      document.documentElement.classList.add('audit-proof-modal-open');
      const lenis = getLenis();
      if (lenis && !lenis.isStopped) {
        pausedLenis = lenis;
        lenis.stop();
      }
      pageIsLocked = true;
    };

    const unlockPage = (): void => {
      if (!preservedLock) document.documentElement.classList.remove('audit-proof-modal-open');
      if (pausedLenis && pausedLenis === getLenis() && pausedLenis.isStopped) {
        pausedLenis.start();
      }
      pausedLenis = null;
      pageIsLocked = false;
    };

    const resetReportMotion = (): void => {
      reports.forEach((report) => {
        report.element.getAnimations().forEach((animation) => animation.cancel());
        delete report.element.dataset.direction;
      });
    };

    const loadSelectedImage = (report: AuditReportPanel): void => {
      if (!dialog.open) return;
      const image = report.captures
        .get(report.selectedCaptureId)
        ?.querySelector<HTMLImageElement>('img[data-src]');
      if (image?.dataset.src && !image.hasAttribute('src')) image.src = image.dataset.src;
    };

    const selectCapture = (report: AuditReportPanel, panelId: string): boolean => {
      const selectedPanel = report.captures.get(panelId);
      if (!selectedPanel) return false;
      report.selectedCaptureId = panelId;
      report.captures.forEach((panel) => {
        panel.hidden = panel !== selectedPanel;
      });
      report.element
        .querySelectorAll<HTMLButtonElement>('[data-audit-select]')
        .forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.auditSelect === panelId));
        });
      if (reportLink && selectedPanel.dataset.auditReportUrl) {
        reportLink.href = selectedPanel.dataset.auditReportUrl;
        reportLink.setAttribute('aria-label', report.reportLabel);
      }
      loadSelectedImage(report);
      if (scrollArea) scrollArea.scrollTop = 0;
      return true;
    };

    const selectReport = (
      index: number,
      direction: 'next' | 'previous' | null,
      panelId?: string
    ): boolean => {
      const selected = reports[index];
      if (!selected || (panelId && !selected.captures.has(panelId))) return false;
      const previous = reports[activeIndex];
      const focusedBefore = document.activeElement;
      const hidesFocusedControl =
        previous !== selected &&
        focusedBefore instanceof HTMLElement &&
        previous?.element.contains(focusedBefore);
      resetReportMotion();
      reports.forEach((report) => {
        report.element.hidden = report !== selected;
      });
      activeIndex = index;
      if (heading) heading.textContent = selected.source;
      if (category) category.textContent = selected.category;
      if (date) {
        date.dateTime = selected.scannedAt;
        date.textContent = selected.dateLabel;
      }
      if (colourNote) colourNote.hidden = selected.id === 'browser';
      dialog.classList.toggle('audit-proof__dialog--pagespeed', selected.id === 'pagespeed');
      selectCapture(selected, panelId ?? selected.selectedCaptureId);
      if (position) {
        position.textContent = `${index + 1} / ${reports.length}`;
        position.setAttribute(
          'aria-label',
          (position.dataset.auditPositionTemplate ?? '')
            .replace('{current}', String(index + 1))
            .replace('{total}', String(reports.length))
        );
      }
      if (direction && previous !== selected) {
        if (announcement)
          announcement.textContent = (announcement.dataset.auditAnnouncementTemplate ?? '')
            .replace('{source}', selected.source)
            .replace('{current}', String(index + 1))
            .replace('{total}', String(reports.length));
        if (motionAllowed.matches) {
          // Commit the cleared animation before starting this user-requested direction.
          void selected.element.offsetWidth;
          selected.element.dataset.direction = direction;
        }
        if (hidesFocusedControl)
          (direction === 'next' ? nextButton : previousButton)?.focus({ preventScroll: true });
      }
      return true;
    };

    const navigateReport = (direction: 'next' | 'previous'): void => {
      if (!dialog.open || dialog.dataset.closing === 'true' || reports.length < 2) return;
      const delta = direction === 'next' ? 1 : -1;
      selectReport((activeIndex + delta + reports.length) % reports.length, direction);
    };

    const requestClose = async (): Promise<void> => {
      if (!dialog.open || dialog.dataset.closing === 'true') return;
      const revision = ++closeRevision;
      resetReportMotion();
      swipe = null;
      dialog.dataset.closing = 'true';
      if (motionAllowed.matches) {
        await Promise.allSettled(dialog.getAnimations().map((animation) => animation.finished));
      }
      if (revision === closeRevision && dialog.open) dialog.close();
    };

    const isBackdrop = (event: MouseEvent): boolean => {
      if (event.target !== dialog) return false;
      const bounds = dialog.getBoundingClientRect();
      return (
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom
      );
    };

    previousButton?.addEventListener('click', () => navigateReport('previous'));
    nextButton?.addEventListener('click', () => navigateReport('next'));
    closeButton?.addEventListener('click', () => void requestClose());
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      void requestClose();
    });
    dialog.addEventListener('pointerdown', (event) => {
      backdropPointerDown = isBackdrop(event);
    });
    dialog.addEventListener('click', (event) => {
      if (backdropPointerDown && isBackdrop(event)) void requestClose();
      backdropPointerDown = false;
    });
    dialog.addEventListener('close', () => {
      if (dialog.open) return;
      ++closeRevision;
      resetReportMotion();
      delete dialog.dataset.closing;
      backdropPointerDown = false;
      swipe = null;
      if (pageIsLocked) unlockPage();
      if (returnFocus?.isConnected) returnFocus.focus({ preventScroll: true });
      returnFocus = null;
      if (announcement) announcement.textContent = '';
    });
    dialog.addEventListener('keydown', (event) => {
      if (
        event.defaultPrevented ||
        event.ctrlKey ||
        event.metaKey ||
        event.altKey ||
        event.shiftKey ||
        (event.target instanceof Element && event.target.closest(editableSelector))
      )
        return;
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      navigateReport(event.key === 'ArrowRight' ? 'next' : 'previous');
    });

    scrollArea?.addEventListener('pointerdown', (event) => {
      swipe = null;
      if (
        event.pointerType !== 'touch' ||
        !event.isPrimary ||
        dialog.dataset.closing === 'true' ||
        window.getSelection()?.isCollapsed === false ||
        (event.target instanceof Element && event.target.closest(interactiveSelector))
      )
        return;
      swipe = { pointerId: event.pointerId, x: event.clientX, y: event.clientY };
    });
    scrollArea?.addEventListener('pointercancel', () => {
      swipe = null;
    });
    scrollArea?.addEventListener('pointerup', (event) => {
      const start = swipe;
      swipe = null;
      if (
        !start ||
        event.pointerType !== 'touch' ||
        event.pointerId !== start.pointerId ||
        window.getSelection()?.isCollapsed === false ||
        (event.target instanceof Element && event.target.closest(interactiveSelector))
      )
        return;
      const deltaX = event.clientX - start.x;
      const deltaY = event.clientY - start.y;
      if (Math.abs(deltaX) >= 60 && Math.abs(deltaX) >= Math.abs(deltaY) * 1.5) {
        navigateReport(deltaX < 0 ? 'next' : 'previous');
      }
    });

    reports.forEach((report) => {
      report.element
        .querySelectorAll<HTMLButtonElement>('[data-audit-select]')
        .forEach((button) => {
          button.addEventListener('click', () => {
            if (
              dialog.open &&
              dialog.dataset.closing !== 'true' &&
              report === reports[activeIndex] &&
              button.dataset.auditSelect
            ) {
              selectCapture(report, button.dataset.auditSelect);
            }
          });
        });
    });

    section.querySelectorAll<HTMLAnchorElement>('a[data-audit-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        const index = reports.findIndex((report) => report.id === trigger.dataset.auditProof);
        const panelId = trigger.dataset.auditPanel;
        if (index < 0 || !panelId || !reports[index]?.captures.has(panelId)) return;
        ++closeRevision;
        dialog.getAnimations().forEach((animation) => animation.cancel());
        delete dialog.dataset.closing;
        if (!selectReport(index, null, panelId)) return;
        try {
          if (!dialog.open) dialog.showModal();
        } catch {
          return;
        }
        lockPage();
        returnFocus = trigger;
        const selected = reports[index];
        if (selected) loadSelectedImage(selected);
        closeButton?.focus({ preventScroll: true });
        event.preventDefault();
      });
    });
  }

  // Keep the Stack-style glass movement local; no global selectors or new animation imports.
  if (section) {
    const glassMotion = window.matchMedia('(prefers-reduced-motion: no-preference)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    section.querySelectorAll<HTMLAnchorElement>('.audit-proof__card').forEach((card) => {
      let bounds: DOMRect | null = null;
      let frame: number | null = null;
      let x = 0;
      let y = 0;
      const reset = (): void => {
        if (frame !== null) window.cancelAnimationFrame(frame);
        frame = null;
        bounds = null;
        card.style.removeProperty('--audit-glass-x');
        card.style.removeProperty('--audit-glass-y');
      };
      card.addEventListener('pointerenter', (event) => {
